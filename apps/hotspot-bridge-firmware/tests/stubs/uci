#!/usr/bin/env python3
"""Minimal stand-in for OpenWrt's uci CLI (enough for these scripts).
State: $UCI_DIR/<config>.json = [{"name":..,"type":..,"anon":bool,"opts":{k: str|list}}]"""
import json, os, re, sys

D = os.environ["UCI_DIR"]
args = sys.argv[1:]
quiet = False
while args and args[0].startswith("-"):
    if args[0] == "-q": quiet = True
    args = args[1:]

def load(c):
    p = os.path.join(D, c + ".json")
    return json.load(open(p)) if os.path.exists(p) else []

def save(c, secs):
    json.dump(secs, open(os.path.join(D, c + ".json"), "w"), indent=1)

def find(secs, ref):
    m = re.fullmatch(r"@([^\[]+)\[(-?\d+)\]", ref)
    if m:
        lst = [s for s in secs if s["type"] == m.group(1)]
        i = int(m.group(2))
        try: return lst[i]
        except IndexError: return None
    return next((s for s in secs if s["name"] == ref), None)

def parse(path):
    parts = path.split(".", 2)
    return parts + [None] * (3 - len(parts))

def fail():
    if not quiet: print("uci: Entry not found", file=sys.stderr)
    sys.exit(1)

def unq(v):
    if len(v) >= 2 and v[0] == v[-1] == "'": return v[1:-1]
    return v

def run(cmd, rest):
    if cmd == "get":
        c, s, o = parse(rest[0]); secs = load(c); sec = find(secs, s)
        if not sec: fail()
        if o is None: print(sec["type"]); return
        if o not in sec["opts"]: fail()
        v = sec["opts"][o]; print(" ".join(v) if isinstance(v, list) else v)
    elif cmd == "set":
        lhs, val = rest[0].split("=", 1); val = unq(val)
        c, s, o = parse(lhs); secs = load(c)
        if o is None:
            sec = find(secs, s)
            if sec: sec["type"] = val
            else: secs.append({"name": s, "type": val, "anon": False, "opts": {}})
        else:
            sec = find(secs, s)
            if not sec: fail()
            sec["opts"][o] = val
        save(c, secs)
    elif cmd == "delete":
        c, s, o = parse(rest[0]); secs = load(c); sec = find(secs, s)
        if not sec: fail()
        if o is None: secs.remove(sec)
        elif o in sec["opts"]: del sec["opts"][o]
        else: fail()
        save(c, secs)
    elif cmd in ("add_list", "del_list"):
        lhs, val = rest[0].split("=", 1); val = unq(val)
        c, s, o = parse(lhs); secs = load(c); sec = find(secs, s)
        if not sec: fail()
        cur = sec["opts"].get(o, [])
        if isinstance(cur, str): cur = [cur]
        if cmd == "add_list": cur.append(val)
        else: cur = [x for x in cur if x != val]
        sec["opts"][o] = cur; save(c, secs)
    elif cmd == "show":
        c = rest[0].split(".")[0]; secs = load(c); counts = {}
        for sec in secs:
            idx = counts.get(sec["type"], 0); counts[sec["type"]] = idx + 1
            n = f"@{sec['type']}[{idx}]" if sec["anon"] else sec["name"]
            print(f"{c}.{n}={sec['type']}")
            for k, v in sec["opts"].items():
                vv = " ".join(f"'{x}'" for x in v) if isinstance(v, list) else f"'{v}'"
                print(f"{c}.{n}.{k}={vv}")
    elif cmd == "commit":
        pass
    elif cmd == "batch":
        for line in sys.stdin:
            line = line.strip()
            if not line: continue
            p = line.split(None, 1); run(p[0], [p[1]] if len(p) > 1 else [])
    else:
        sys.exit("unsupported: " + cmd)

run(args[0], args[1:])
