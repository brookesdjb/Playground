#!/usr/bin/env python3
"""Tiny jsonfilter stand-in: -s STR | stdin, -e '@.a.b' or '@.a.b[*].c'."""
import json, sys
a = sys.argv[1:]; src = None; expr = None
while a:
    if a[0] == "-s": src = a[1]; a = a[2:]
    elif a[0] == "-e": expr = a[1]; a = a[2:]
    else: a = a[1:]
data = json.loads(src if src is not None else sys.stdin.read())
vals = [data]
for part in expr[2:].split("."):
    star = part.endswith("[*]")
    key = part[:-3] if star else part
    nxt = []
    for v in vals:
        if isinstance(v, dict) and key in v:
            x = v[key]
            if star and isinstance(x, list): nxt.extend(x)
            else: nxt.append(x)
    vals = nxt
if not vals: sys.exit(1)
for v in vals:
    print(v if isinstance(v, str) else json.dumps(v))
